generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id               String    @id @default(cuid())
  slug             String    @unique
  title            String
  companyName      String
  companyLogo      String?
  description      String    @db.Text
  shortDescription String?   @db.Text
  location         String
  city             String?
  state            String?
  country          String?
  area             String?
  category         String?
  subCategory      String?
  experienceMin    Int?
  experienceMax    Int?
  experienceText   String?
  education        String?
  skills           String[]  @default([])
  salaryMin        Int?
  salaryMax        Int?
  salaryText       String?
  employmentType   String?
  workMode         String?   // REMOTE, HYBRID, ONSITE
  sourceName       String
  sourceUrl        String
  originalJobUrl   String
  applyUrl         String
  sourceJobId      String?
  duplicateHash    String?   @unique
  
  postedAt         DateTime?
  lastVerifiedAt   DateTime?
  expiresAt        DateTime?
  
  status           JobStatus @default(PENDING_REVIEW)
  isFeatured       Boolean   @default(false)
  isVerified       Boolean   @default(false)
  isRemote         Boolean   @default(false)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([slug])
  @@index([status])
  @@index([city])
  @@index([category])
  @@index([companyName])
  @@index([postedAt])
  @@index([expiresAt])
}

enum JobStatus {
  ACTIVE
  EXPIRED
  REMOVED
  PENDING_REVIEW
  REJECTED
}

model Source {
  id              String    @id @default(cuid())
  name            String    @unique
  type            String    // API, RSS, CAREER_PAGE
  sourceUrl       String
  apiFeedUrl      String?
  isEnabled       Boolean   @default(true)
  lastFetchStatus String?   // SUCCESS, ERROR
  lastFetchAt     DateTime?
  lastError       String?
  jobsImported    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Report {
  id        String       @id @default(cuid())
  jobId     String
  reason    ReportReason
  details   String?      @db.Text
  createdAt DateTime     @default(now())
  status    ReportStatus @default(PENDING)
}

enum ReportReason {
  EXPIRED
  WRONG_INFO
  SCAM
  BROKEN_LINK
  DUPLICATE
  WRONG_LOCATION
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
}
